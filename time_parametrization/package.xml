<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>time_parametrization</name>
  <version>0.0.0</version>
  <description>ROS 2 action server that retimes MoveIt trajectories with Time-Optimal Trajectory Generation (TOTG)</description>
  <maintainer email="manuel.beschi@unibs.it">jacobi</maintainer>
  <license>BSD-3-Clause</license>

  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>time_parametrization_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning</depend>
  <depend>yaml-cpp</depend>


  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <depend>control_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
